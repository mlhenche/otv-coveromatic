{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"]
        },

        // strict diferido a Fase 2 — ver el plan de optimización.
        // Encender estos flags (junto con la eliminación de `any`) es la
        // primera tarea del refactor de código.
        "strict": false,
        "noImplicitAny": false
    },
    "include": ["."]
}
