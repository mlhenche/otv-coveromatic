{
  "name": "coveromatic",
  "version": "1.0.0",
  "description": "Plugin de Figma para aplicar carátulas y metadatos de Orange TV.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:backend && vite build && mv plugin/index.html plugin/ui.html",
    "build:backend": "tsc -p src/tsconfig.json --noEmit && esbuild src/code.ts --bundle --format=iife --target=es2017 --outfile=plugin/code.js",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p src/tsconfig.json --noEmit && tsc -p src/ui/tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.123.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.8"
  }
}
